{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "outDir": "./dist", // Скомпилированные файлы будут помещены в папку dist
    "rootDir": "./src", // Исходные файлы находятся в папке src
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"], // Указываем, что компилировать только файлы из src
  "exclude": ["node_modules"]
}
